# Dataset
DATASET_NAME=mbien/recipe_nlg
DATASET_SPLIT=train
MAX_RECIPES=50000

# Paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
ARTIFACTS_DIR=data/artifacts

# API
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit -> API
API_BASE_URL=http://localhost:8000

# Dataset directory holding full_dataset.csv
DATASET_DIR=data/raw

# --- LLM (optional) ---
# Leave LLM_ENABLED=false to run the bot with template responses only.
LLM_ENABLED=false
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
# Never commit a real key. Export it in your shell or put it in .env (gitignored).
ANTHROPIC_API_KEY=

# Ranking: score = cosine * coverage**COVERAGE_WEIGHT. 0 disables the boost.
COVERAGE_WEIGHT=1.0
