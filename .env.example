# Dataset
DATASET_NAME=mbien/recipe_nlg
DATASET_SPLIT=train
MAX_RECIPES=50000

# Paths
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
ARTIFACTS_DIR=data/artifacts

# API
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit -> API
API_BASE_URL=http://localhost:8000

# Dataset directory holding full_dataset.csv
DATASET_DIR=data/raw

# --- LLM (optional) ---
# The app runs fully without this; replies fall back to templates.
LLM_ENABLED=false

# Provider: gemini (free tier) or anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite

# Never commit a real key. This file is the template; .env is gitignored.
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Only needed if LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
